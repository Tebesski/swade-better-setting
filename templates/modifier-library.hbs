{{#*inline "costOption"}}
  <div class="sbs-library-option" data-option-id="{{id}}">
    <div class="sbs-library-option-fields">
      <input type="text" data-option-name value="{{label}}" aria-label="{{localize "swade-better-setting.UI.Optionname_f11b303eb8"}}" placeholder="{{localize "swade-better-setting.UI.Optionname_f11b303eb8"}}">
      <span class="sbs-library-cost">( <span contenteditable="plaintext-only" role="textbox" inputmode="decimal" data-option-cost data-placeholder="{{localize "swade-better-setting.UI.N_8ce86a6ae6"}}" aria-label="{{localize "swade-better-setting.UI.PowerPointcost_f86ba667c7"}}">{{costText}}</span> )</span>
      {{#if removable}}
        <button type="button" data-action="removeOption" aria-label="{{localize "swade-better-setting.UI.Deleteoption_6095714905"}}"><i class="fa-solid fa-xmark" inert></i></button>
      {{/if}}
    </div>
    {{#if @root.powers}}<div data-library-behaviors="powers"></div>{{/if}}
    {{#if @root.templates}}<div data-library-behaviors="templates"></div>{{/if}}
  </div>
{{/inline}}
<section class="sbs-library-entries standard-form">
  <input type="search" aria-label="{{localize "swade-better-setting.UI.Searchmodifiers_9bc57fc48f"}}" placeholder="{{localize "swade-better-setting.UI.Searchmodifiers_3d4c06644d"}}" value="{{search}}">
  {{#each groups}}
    <details class="sbs-library-group" data-group-name="{{label}}" {{#if open}}open{{/if}}>
      <summary>{{label}}</summary>
      {{#if @root.editable}}
        <button type="button" class="sbs-create-modifier" data-action="create"><i class="fa-solid fa-plus" inert></i> {{localize "swade-better-setting.UI.CreateModifier_1e57ef92b1"}}</button>
      {{/if}}
      {{#each rows}}
        <details class="sbs-library-modifier" data-modifier-id="{{id}}" data-name="{{name}}" {{#if expanded}}open{{/if}}>
          <summary {{#unless global}}draggable="true" data-modifier-id="{{id}}"{{/unless}}>
            {{#unless global}}<i class="fa-solid fa-grip-vertical" inert></i>{{/unless}} <span data-modifier-title>{{name}}</span>
          </summary>
          <div class="sbs-modifier-library-body">
            {{#if @root.editable}}
              <input type="text" aria-label="{{localize "swade-better-setting.UI.Modifiername_28221db4cc"}}" data-modifier-name value="{{name}}">
              <prose-mirror toggled editable="true" aria-label="{{localize "swade-better-setting.UI.Modifierdescription_560e6fefe3"}}" name="sbs-description-{{id}}" value="{{description}}">{{{description}}}</prose-mirror>
              <fieldset aria-label="{{localize "swade-better-setting.UI.Modifieroptions_59412003d2"}}">
                {{#each options}}{{> costOption}}{{/each}}
              </fieldset>
              <div class="sbs-modifier-library-actions">
                <button type="button" data-action="addOption"><i class="fa-solid fa-plus" inert></i> {{localize "swade-better-setting.UI.AddModifierOption_d1ba8ab0e6"}}</button>
                <button type="button" data-action="remove" aria-label="{{localize "swade-better-setting.UI.Removemodifier_f66e522d96"}}"><i class="fa-solid fa-trash" inert></i></button>
              </div>
            {{else}}
              {{{description}}}
              <ul>{{#each options}}<li>{{#if label}}{{label}} {{/if}}({{displayCost}} {{localize "swade-better-setting.UI.PP_484f800de8"}}</li>{{/each}}</ul>
              {{#if @root.picker}}<button type="button" data-action="select"><i class="fa-solid fa-plus" inert></i> {{localize "swade-better-setting.UI.AddtoPower_0164542d27"}}</button>{{/if}}
            {{/if}}
          </div>
        </details>
      {{else}}<p class="hint">{{localize "swade-better-setting.UI.No_1ea442a134"}} {{label}} {{localize "swade-better-setting.UI.modifiers_195236e788"}}</p>{{/each}}
    </details>
  {{/each}}
</section>
