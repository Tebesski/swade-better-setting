<section class="sbs-npc-build" aria-label="{{localize "swade-better-setting.UI.NPCconfiguration_c290f26901"}}">
  <datalist id="{{traitListId}}">{{#each skillChoices}}<option value="{{this}}"></option>{{/each}}</datalist>
  <details data-section="combat" open>
    <summary>{{localize "swade-better-setting.UI.Combatprofile_7ad6d74078"}}</summary>
    <div class="sbs-npc-fields">
      <div class="sbs-npc-hardy">
        <label class="sbs-npc-check"><input type="checkbox" data-path="hardy" {{checked draft.hardy}}> {{localize "swade-better-setting.UI.Hardy_f3c19b4122"}}</label>
        <i class="fa-solid fa-circle-info sbs-npc-info" tabindex="0" aria-label="{{localize "swade-better-setting.UI.AsecondShakenresultdoesnot_8958fe857c"}}" data-tooltip="{{localize "swade-better-setting.UI.AsecondShakenresultdoesnot_8958fe857c"}}"></i>
      </div>
      {{#each initiative}}
        <div class="sbs-npc-hardy">
          <label class="sbs-npc-check"><input type="checkbox" data-path="initiative.{{key}}" {{checked checked}}> {{label}}</label>
          <i class="fa-solid fa-circle-info sbs-npc-info" tabindex="0" aria-label="{{hint}}" data-tooltip="{{hint}}"></i>
        </div>
      {{/each}}
      <label><span>{{localize "swade-better-setting.UI.Follow_641d1ef657"}} <i class="fa-solid fa-circle-info sbs-npc-info" tabindex="0"
        aria-label="{{localize "swade-better-setting.UI.Entertheexactnameofa_5f28549e60"}}"
        data-tooltip="{{localize "swade-better-setting.UI.Entertheexactnameofa_5f28549e60"}}"></i></span>
        <input type="text" data-path="initiative.follow" value="{{draft.initiative.follow}}" placeholder="{{localize "swade-better-setting.UI.Leadername_7863c01b59"}}">
      </label>
    </div>

    <details class="sbs-npc-nested" data-section="attacks" open>
      <summary>{{localize "swade-better-setting.UI.Attacks_1e3a955bd2"}}</summary>
      <div class="sbs-npc-fields">
        <label>{{localize "swade-better-setting.UI.Attack_4cd548f3cc"}}
          <select data-path="mode" aria-label="{{localize "swade-better-setting.UI.Attack_4cd548f3cc"}}">{{selectOptions modes selected=draft.mode}}</select>
        </label>
        {{#if hasAttack}}
          <label>{{localize "swade-better-setting.UI.Attackname_435bae4bcc"}}<input type="text" data-path="attackName" value="{{draft.attackName}}"></label>
          {{#unless power}}
            <div class="sbs-npc-with-picker">
              <label for="{{partId}}-attack-trait">{{localize "swade-better-setting.UI.Attacktrait_3bc2580099"}}</label>
              <input id="{{partId}}-attack-trait" type="text" data-path="trait" value="{{draft.trait}}" list="{{traitListId}}">
              <button type="button" class="icon fa-solid fa-list" data-action="pickTrait" data-path="trait" aria-label="{{localize "swade-better-setting.UI.Chooseattacktrait_9b025956a3"}}"></button>
            </div>
          {{/unless}}
        {{/if}}
      </div>
      {{#if hasAttack}}
        <div class="sbs-npc-fields sbs-npc-damage-row">
          <div class="sbs-npc-with-picker sbs-npc-damage-field">
            <label for="{{partId}}-signature-damage">{{localize "swade-better-setting.UI.Damageformula_c6292464ab"}}</label>
            {{#if tinyMelee}}<input id="{{partId}}-signature-damage" type="text" value="1" readonly>{{else}}
              <input id="{{partId}}-signature-damage" type="text" data-path="damage" value="{{draft.damage}}" placeholder="{{localize "swade-better-setting.UI.str1d6_f4462e194c"}}">
            {{/if}}
            <button type="button" class="icon fa-solid fa-scale-balanced" data-action="damageGuide" data-key="signature" aria-label="{{localize "swade-better-setting.UI.Opendamageguide_a6a44ce96d"}}"></button>
          </div>
          <label>{{localize "swade-better-setting.UI.AP_84810bfea2"}}
            <input type="number" data-path="ap" min="0" max="40" value="{{draft.ap}}" aria-label="{{localize "swade-better-setting.UI.ArmorPiercing_79c97ba061"}}"></label>
          {{#unless (eq draft.mode "melee")}}<label>{{localize "swade-better-setting.UI.Range_5de74a81b1"}}<input type="text" data-path="range" value="{{draft.range}}"></label>{{/unless}}
          {{#if power}}
            <label>{{localize "swade-better-setting.UI.Spellcastingentry_6b0027c406"}}<select data-path="signatureEntry">{{selectOptions entryChoices selected=draft.signatureEntry}}</select></label>
            <label>{{localize "swade-better-setting.UI.Powercost_5418e9efc8"}}<input type="number" data-path="powerCost" min="0" max="100" value="{{draft.powerCost}}"></label>
          {{/if}}
          {{#if ranged}}<label>{{localize "swade-better-setting.UI.RoF_85f8430d31"}}
            <input type="number" data-path="signatureRof" min="1" max="6" value="{{draft.signatureRof}}" aria-label="{{localize "swade-better-setting.UI.RateofFire_b85769f4ac"}}"></label>{{/if}}
        </div>
      {{/if}}
      {{#if damageError}}<p class="hint" role="status">{{damageError}}</p>{{/if}}
      {{#if hasAttack}}{{> "modules/swade-better-setting/templates/npc-attack-options.hbs" signatureDetails}}{{/if}}
      <div class="sbs-npc-library-bar">
        <button type="button" data-action="addAttack"><i class="fa-solid fa-plus" inert></i> {{localize "swade-better-setting.UI.Addattack_1c2b97628f"}}</button>
        <button type="button" data-action="addWeapon"><i class="fa-solid fa-list" inert></i> {{localize "swade-better-setting.UI.Addweaponfromlibrary_cf376d2975"}}</button>
      </div>
      {{#each attackRows}}
        <details class="sbs-npc-nested" data-section="attack-{{_id}}" open>
          <summary>{{name}}</summary>
          <div class="sbs-npc-fields">
            <label>{{localize "swade-better-setting.UI.Attackname_435bae4bcc"}}<input type="text" data-attack="{{_id}}" data-attack-field="name" value="{{name}}"></label>
            <label>{{localize "swade-better-setting.UI.Attacktype_37e8585d49"}}<select data-attack="{{_id}}" data-attack-field="system.rangeType" data-number>{{selectOptions @root.weaponModes selected=system.rangeType}}</select></label>
            <div class="sbs-npc-with-picker">
              <label for="{{@root.partId}}-trait-{{_id}}">{{localize "swade-better-setting.UI.Attacktrait_3bc2580099"}}</label>
              <input id="{{@root.partId}}-trait-{{_id}}" type="text" data-attack="{{_id}}" data-attack-field="system.actions.trait" value="{{system.actions.trait}}" list="{{@root.traitListId}}">
              <button type="button" class="icon fa-solid fa-list" data-action="pickTrait" data-attack="{{_id}}" aria-label="Choose {{name}} attack trait"></button>
            </div>
            <div class="sbs-npc-with-picker sbs-npc-damage-field">
              <label for="{{@root.partId}}-damage-{{_id}}">{{localize "swade-better-setting.UI.Damageformula_c6292464ab"}}</label>
              <input id="{{@root.partId}}-damage-{{_id}}" type="text" data-attack="{{_id}}" data-attack-field="system.damage" value="{{system.damage}}">
              <button type="button" class="icon fa-solid fa-scale-balanced" data-action="damageGuide" data-key="{{_id}}" aria-label="Open damage guide for {{name}}"></button>
            </div>
            <label>{{localize "swade-better-setting.UI.AP_84810bfea2"}}<input type="number" min="0" max="40" data-attack="{{_id}}" data-attack-field="system.ap" value="{{system.ap}}" aria-label="{{localize "swade-better-setting.UI.ArmorPiercing_79c97ba061"}}"></label>
            {{#unless (eq system.rangeType 0)}}
              <label>{{localize "swade-better-setting.UI.Range_5de74a81b1"}}<input type="text" data-attack="{{_id}}" data-attack-field="system.range" value="{{system.range}}"></label>
              <label>{{localize "swade-better-setting.UI.RoF_85f8430d31"}}<input type="number" min="1" max="6" data-attack="{{_id}}" data-attack-field="system.rof" value="{{system.rof}}" aria-label="{{localize "swade-better-setting.UI.RateofFire_b85769f4ac"}}"></label>
            {{/unless}}
          </div>
          {{> "modules/swade-better-setting/templates/npc-attack-options.hbs" details}}
          <div class="sbs-npc-library-bar">
            <button type="button" data-action="removeFeature" data-key="{{_id}}"><i class="fa-solid fa-xmark" inert></i> {{localize "swade-better-setting.UI.Removeattack_52e995ec76"}}</button>
          </div>
        </details>
      {{/each}}
    </details>

  </details>

  <details data-section="movement">
    <summary>{{localize "swade-better-setting.UI.Movement_49ba63e89a"}}</summary>
    <div class="sbs-npc-fields sbs-npc-move-fields">
      <label>{{localize "swade-better-setting.UI.Defaultmode_e4810f30b9"}}<select data-path="paceBase">{{selectOptions movementModes selected=draft.paceBase blank="Automatic"}}</select></label>
      <label>{{localize "swade-better-setting.UI.Walk_08ee52ae12"}}<input type="number" data-path="ground" min="0" max="100" value="{{draft.ground}}"></label>
      <label>{{localize "swade-better-setting.UI.Fly_31bbe05d43"}}<input type="number" data-path="fly" min="0" max="100" value="{{draft.fly}}"></label>
      <label>{{localize "swade-better-setting.UI.Swim_dd4fa375c7"}}<input type="number" data-path="swim" min="0" max="100" value="{{draft.swim}}"></label>
      <label>{{localize "swade-better-setting.UI.Burrow_339a13fffc"}}<input type="number" data-path="burrow" min="0" max="100" value="{{draft.burrow}}"></label>
      <label>{{localize "swade-better-setting.UI.Runningdie_d1032010c7"}}<select data-path="run" data-number>{{selectOptions dice selected=draft.run}}</select></label>
      <label>{{localize "swade-better-setting.UI.Runningmodifier_e92c7f3b41"}}<input type="number" data-path="runMod" min="-20" max="20" value="{{draft.runMod}}"></label>
    </div>
    <div class="sbs-npc-library-bar">
      <button type="button" data-action="movementTable"><i class="fa-solid fa-table-list" inert></i> {{localize "swade-better-setting.UI.Movementpresets_dcb0a1b258"}}</button>
    </div>
  </details>

  <details data-section="casting">
    <summary>{{localize "swade-better-setting.UI.Spellcastingentries_307dcea611"}}</summary>
    <div class="sbs-npc-library-bar">
      <button type="button" data-action="addCasting"><i class="fa-solid fa-plus" inert></i> {{localize "swade-better-setting.UI.Addspellcastingentry_4ab59200f2"}}</button>
    </div>
    {{#each castingEntries}}
      <details class="sbs-npc-nested" data-section="casting-{{id}}" open>
        <summary>{{name}}</summary>
        <div class="sbs-npc-fields">
          {{#unless general}}<label>{{localize "swade-better-setting.UI.Entryname_978463c089"}}<input type="text" data-entry="{{id}}" data-entry-field="name" value="{{name}}" aria-label="{{name}} entry name"></label>{{/unless}}
          <div class="sbs-npc-with-picker">
            <label for="{{@root.partId}}-cast-{{id}}">{{localize "swade-better-setting.UI.Castingtrait_452e2719b0"}}</label>
            <input id="{{@root.partId}}-cast-{{id}}" type="text" data-entry="{{id}}" data-entry-field="trait" value="{{trait}}" list="{{@root.traitListId}}" aria-label="{{name}} casting trait">
            <button type="button" class="icon fa-solid fa-list" data-action="pickTrait" data-entry="{{id}}" aria-label="Choose {{name}} casting trait"></button>
          </div>
          {{#if usesPP}}<label>{{localize "swade-better-setting.UI.PowerPoints_844847817f"}}<input type="number" data-entry="{{id}}" data-entry-field="points" min="0" max="999" value="{{points}}" aria-label="{{name}} Power Points"></label>{{/if}}
          {{#if @root.hasBetterPowers}}<label>{{localize "swade-better-setting.UI.Castingrule_9f2904259a"}}<select data-entry="{{id}}" data-entry-field="rule" aria-label="{{name}} casting rule">{{selectOptions @root.castingRules selected=rule}}</select></label>{{/if}}
        </div>
        <div class="sbs-npc-library-bar">
          <button type="button" data-action="addPower" data-key="{{id}}"><i class="fa-solid fa-plus" inert></i> {{localize "swade-better-setting.UI.AddPower_47801ca8b2"}}</button>
          <button type="button" data-action="generatePowers" data-key="{{id}}"><i class="fa-solid fa-wand-magic-sparkles" inert></i> {{localize "swade-better-setting.UI.GeneratePowers_3281bb805e"}}</button>
          <button type="button" class="icon fa-solid fa-xmark" data-action="removeCasting" data-key="{{id}}" aria-label="Remove {{name}} entry"></button>
        </div>
        {{#if signature}}<p class="hint">{{signature}} {{localize "swade-better-setting.UI.presetattack_20c1a9cd7a"}}</p>{{/if}}
        <ul class="sbs-npc-features unmarked-list">
          {{#each powers}}
            <li>
              {{#if inherited}}<span>{{name}} <small>{{localize "swade-better-setting.UI.ancestry_793b2c69eb"}}</small></span>{{else}}
                <button type="button" class="sbs-npc-feature-link" data-action="openFeature" data-key="{{_id}}"><img src="{{img}}" alt=""><span>{{name}}</span></button>
              {{/if}}
              <select data-power-entry="{{_id}}" aria-label="{{name}} spellcasting entry">{{selectOptions @root.entryChoices selected=../id}}</select>
              {{#unless inherited}}<button type="button" class="icon fa-solid fa-xmark" data-action="removeFeature" data-key="{{_id}}" aria-label="Remove {{name}}"></button>{{/unless}}
            </li>
          {{/each}}
        </ul>
      </details>
    {{/each}}
  </details>

  <details data-section="features">
    <summary>{{localize "swade-better-setting.UI.Features_5697d03dae"}}</summary>
    {{#if ancestryGrants}}<p class="hint">{{localize "swade-better-setting.UI.Grantedbyancestry_e4068c16d9"}} {{ancestryGrants}}</p>{{/if}}
    <div class="sbs-npc-library-bar">
      <select name="featureType" aria-label="{{localize "swade-better-setting.UI.Featuretype_1458d416e1"}}">{{selectOptions featureTypes selected=featureType}}</select>
      <button type="button" data-action="addFeature"><i class="fa-solid fa-list" inert></i> {{localize "swade-better-setting.UI.Addfromlibrary_919e16f5a2"}}</button>
      <button type="button" data-action="addNewFeature"><i class="fa-solid fa-plus" inert></i> {{localize "swade-better-setting.UI.AddNew_c1dc92c680"}}</button>
      {{#if hasVariants}}<button type="button" data-action="rerollVariants"><i class="fa-solid fa-dice" inert></i> {{localize "swade-better-setting.UI.Rerollpresetoptions_2aea0324bb"}}</button>{{/if}}
    </div>
    <ul class="sbs-npc-features unmarked-list">
      {{#each features}}
        <li>
          <button type="button" class="sbs-npc-feature-link" data-action="openFeature" data-key="{{_id}}"><img src="{{img}}" alt=""><span>{{name}}</span></button><small>{{typeLabel}}</small>
          <button type="button" class="icon fa-solid fa-xmark" data-action="removeFeature" data-key="{{_id}}" aria-label="Remove {{name}}"></button>
        </li>
      {{/each}}
      {{#each draft.effects}}
        <li>
          <button type="button" class="sbs-npc-feature-link" data-action="openFeature" data-key="{{_id}}"><img src="{{img}}" alt=""><span>{{name}}</span></button><small>{{localize "swade-better-setting.UI.Effect_2252d5cf93"}}</small>
          <button type="button" class="icon fa-solid fa-xmark" data-action="removeEffect" data-key="{{_id}}" aria-label="Remove {{name}}"></button>
        </li>
      {{/each}}
    </ul>
  </details>
</section>
