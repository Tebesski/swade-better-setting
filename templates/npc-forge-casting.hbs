<details class="sbs-editor-accordion" data-section="casting">
  <summary>{{localize "swade-better-setting.UI.Spellcastingpools_7572c2e419"}}</summary>
  <p class="hint">{{localize "swade-better-setting.UI.Matchpowerstoanamedpool_d9356cda9e"}}</p>
  {{#each this}}
    <div class="sbs-ancestry-trait">
      <div class="sbs-preset-fields">
        <label>{{localize "swade-better-setting.UI.Name_dcd1d5223f"}}<input type="text" name="casting-name-{{@index}}" value="{{name}}" placeholder="{{localize "swade-better-setting.UI.Spellcasting_0ce3a662d1"}}"></label>
        <label>{{localize "swade-better-setting.UI.Castingtrait_452e2719b0"}}<span class="sbs-inline-picker">
          <input type="text" name="casting-trait-{{@index}}" value="{{trait}}">
          <button type="button" class="icon fa-solid fa-list" data-action="pickTrait" data-input="casting-trait-{{@index}}" aria-label="{{localize "swade-better-setting.UI.Choosecastingtrait_fa422539f1"}}"></button>
        </span></label>
        <label>{{localize "swade-better-setting.UI.StartingPP_b0a32b81b1"}}<input type="number" name="casting-points-{{@index}}" min="0" max="999" value="{{points}}"></label>
        <label>{{localize "swade-better-setting.UI.PPperrank_9f3c3485c4"}}<input type="number" name="casting-growth-{{@index}}" min="0" max="99" value="{{growth}}"></label>
        <label>{{localize "swade-better-setting.UI.Castingrule_9f2904259a"}}<select name="casting-rule-{{@index}}">{{selectOptions @root.castingRules selected=rule}}</select></label>
        <button type="button" class="icon fa-solid fa-xmark" data-action="removeCasting" data-index="{{@index}}" aria-label="{{localize "swade-better-setting.UI.Removepool_f7ef7a2358"}}"></button>
      </div>
      {{#if @root.canRequireEdge}}
        <div class="sbs-npc-library-bar">
          {{#if requires}}<span>{{localize "swade-better-setting.UI.Requires_143f0330d2"}} {{requires.name}}</span>
            <button type="button" class="icon fa-solid fa-xmark" data-action="clearEdge" data-index="{{@index}}" aria-label="{{localize "swade-better-setting.UI.Removerequirededge_f16d47a835"}}"></button>{{/if}}
          <button type="button" data-action="pickEdge" data-index="{{@index}}"><i class="fa-solid fa-list" inert></i> {{localize "swade-better-setting.UI.Requireanedge_4f981cd9c8"}}</button>
        </div>
      {{/if}}
    </div>
  {{/each}}
  <button type="button" data-action="addCasting"><i class="fa-solid fa-plus" inert></i> {{localize "swade-better-setting.UI.Addcastingpool_e3306d587b"}}</button>
</details>
