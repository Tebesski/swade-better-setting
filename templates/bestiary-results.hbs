<section class="sbs-bestiary-results" aria-label="{{localize "swade-better-setting.UI.NPCresults_6705162d74"}}">
  <div class="sbs-bestiary-status">
    <strong role="status">{{#if loading}}{{localize "swade-better-setting.UI.Loadingbestiary_4fff8e3f3f"}}{{else if filtering}}{{localize "swade-better-setting.UI.Readingfilterdata_0561fbed79"}}{{else if filteringCR}}{{localize "swade-better-setting.UI.CalculatingCRforthefilter_e3c27771ef"}}{{else if sortingCR}}{{localize "swade-better-setting.UI.CalculatingCRtosort_dcf2d222df"}} {{count}} {{localize "swade-better-setting.UI.NPCs_8e862ca2aa"}}{{else}}{{count}} {{#if (eq count 1)}}{{localize "swade-better-setting.UI.NPC_f2d1dab083"}}{{else}}{{localize "swade-better-setting.UI.NPCs_32dfcbda15"}}{{/if}}{{/if}}</strong>
    <div class="sbs-bestiary-tools">
      {{#if canBuild}}<button type="button" data-action="build"><i class="fa-solid fa-hammer" inert></i> {{localize "swade-better-setting.UI.NPCBuilder_3ca078e37c"}}</button>{{/if}}
      <button type="button" class="icon fa-solid fa-rotate" data-action="refresh" aria-label="{{localize "swade-better-setting.UI.Refresh_0e91610117"}}" data-tooltip="{{localize "swade-better-setting.UI.RefreshBestiary_9484d58bcc"}}" {{disabled loading}}></button>
    </div>
  </div>
  {{#if failed}}<p class="sbs-bestiary-warning">{{localize "swade-better-setting.UI.Couldnotread_63558e6752"}} {{failed}}{{localize "swade-better-setting.UI.UseRefreshtoretry_68ff1d8222"}}</p>{{/if}}
  <ol class="sbs-bestiary-list unmarked-list" aria-label="{{localize "swade-better-setting.UI.MatchingNPCs_55d5ab3942"}}">
    {{#each matches}}
      <li data-uuid="{{uuid}}" {{#if @root.canDrag}}draggable="true"{{/if}}>
        <button type="button" class="sbs-bestiary-npc" data-action="openActor" data-uuid="{{uuid}}" aria-label="{{name}}" title="{{source.name}} · {{#if wildcard}}Wild Card{{else}}Extra{{/if}}">
          <img src="{{img}}" loading="lazy" draggable="false" alt="">
          <span>{{name}}</span>
          {{#if wildcard}}<i class="fa-solid fa-cards" title="{{localize "swade-better-setting.UI.WildCard_1af0ffaf1f"}}" inert></i>{{/if}}
        </button>
        <div class="sbs-bestiary-badges">
          <span class="sbs-bestiary-rank" data-rank="{{rankClass}}">{{rank}}</span>
          <span class="sbs-bestiary-cr" data-cr-uuid="{{uuid}}" title="{{rating.title}}">{{rating.value}}</span>
        </div>
      </li>
    {{else}}
      {{#unless (or loading filtering filteringCR)}}<li class="sbs-bestiary-empty">{{localize "swade-better-setting.UI.NoNPCsmatchyoursearchand_c579cdecac"}}</li>{{/unless}}
    {{/each}}
  </ol>
  {{#if hasPages}}
    <div class="sbs-bestiary-pages" aria-label="{{localize "swade-better-setting.UI.Resultpages_d6ee7b9515"}}">
      <button type="button" data-action="previous" {{disabled (not previous)}}><i class="fa-solid fa-chevron-left" inert></i> {{localize "swade-better-setting.UI.Previous_a57b08a480"}}</button>
      <span>{{localize "swade-better-setting.UI.Page_0a30a815d6"}} {{page}} {{localize "swade-better-setting.UI.of_28391d3bc6"}} {{pages}}</span>
      <button type="button" data-action="next" {{disabled (not next)}}>{{localize "swade-better-setting.UI.Next_1ff57a29d7"}} <i class="fa-solid fa-chevron-right" inert></i></button>
    </div>
  {{/if}}
</section>
