<section class="sbs-bestiary-results" aria-label="NPC results">
  <div class="sbs-bestiary-status">
    <strong role="status">{{#if loading}}Loading bestiary…{{else if filtering}}Reading filter data…{{else if sortingCR}}Calculating CR to sort {{count}} NPCs…{{else}}{{count}} {{#if (eq count 1)}}NPC{{else}}NPCs{{/if}}{{/if}}</strong>
    <div class="sbs-bestiary-tools">
      {{#if canBuild}}<button type="button" data-action="build"><i class="fa-solid fa-hammer" inert></i> NPC Builder</button>{{/if}}
      <button type="button" class="icon fa-solid fa-rotate" data-action="refresh" aria-label="Refresh" data-tooltip="Refresh Bestiary" {{disabled loading}}></button>
    </div>
  </div>
  {{#if failed}}<p class="sbs-bestiary-warning">Could not read: {{failed}}. Use Refresh to retry.</p>{{/if}}
  <ol class="sbs-bestiary-list unmarked-list" aria-label="Matching NPCs">
    {{#each matches}}
      <li data-uuid="{{uuid}}" {{#if @root.canDrag}}draggable="true"{{/if}}>
        <button type="button" class="sbs-bestiary-npc" data-action="openActor" data-uuid="{{uuid}}" aria-label="{{name}}" title="{{source.name}} · {{#if wildcard}}Wild Card{{else}}Extra{{/if}}">
          <img src="{{img}}" loading="lazy" draggable="false" alt="">
          <span>{{name}}</span>
          {{#if wildcard}}<i class="fa-solid fa-cards" title="Wild Card" inert></i>{{/if}}
        </button>
        <div class="sbs-bestiary-badges">
          <span class="sbs-bestiary-rank" data-rank="{{rankClass}}">{{rank}}</span>
          <span class="sbs-bestiary-cr" data-cr-uuid="{{uuid}}" title="{{rating.title}}">{{rating.value}}</span>
        </div>
      </li>
    {{else}}
      {{#unless (or loading filtering)}}<li class="sbs-bestiary-empty">No NPCs match your search and filters.</li>{{/unless}}
    {{/each}}
  </ol>
  {{#if hasPages}}
    <div class="sbs-bestiary-pages" aria-label="Result pages">
      <button type="button" data-action="previous" {{disabled (not previous)}}><i class="fa-solid fa-chevron-left" inert></i> Previous</button>
      <span>Page {{page}} of {{pages}}</span>
      <button type="button" data-action="next" {{disabled (not next)}}>Next <i class="fa-solid fa-chevron-right" inert></i></button>
    </div>
  {{/if}}
</section>
