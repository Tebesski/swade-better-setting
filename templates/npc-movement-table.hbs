<section class="sbs-size-picker-content">
  <p>{{localize "swade-better-setting.UI.Choosearowtoapplyits_dc6ded303b"}}</p>
  <div class="sbs-size-table-scroll">
    <table class="sbs-movement-table" aria-label="{{localize "swade-better-setting.UI.Movementpresets_dcb0a1b258"}}">
      <thead><tr><th>{{localize "swade-better-setting.UI.Preset_7252e7ce00"}}</th><th>{{localize "swade-better-setting.UI.Default_21b111cbfe"}}</th><th>{{localize "swade-better-setting.UI.Walk_08ee52ae12"}}</th><th>{{localize "swade-better-setting.UI.Fly_31bbe05d43"}}</th><th>{{localize "swade-better-setting.UI.Swim_dd4fa375c7"}}</th><th>{{localize "swade-better-setting.UI.Burrow_339a13fffc"}}</th><th>{{localize "swade-better-setting.UI.Runningdie_d1032010c7"}}</th><th>{{localize "swade-better-setting.UI.Modifier_42e37604b6"}}</th>{{#if canManage}}<th>{{localize "swade-better-setting.UI.Manage_5a23444828"}}</th>{{/if}}</tr></thead>
      <tbody>
        {{#each rows}}
          <tr>
            <th scope="row"><button type="button" data-action="apply" data-key="{{id}}">{{label}}</button></th>
            <td>{{mode}}</td><td>{{ground}}</td><td>{{fly}}</td><td>{{swim}}</td><td>{{burrow}}</td><td>{{localize "swade-better-setting.UI.d_18ac3e7343"}}{{run}}</td><td>{{runMod}}</td>
            {{#if @root.canManage}}<td class="sbs-movement-actions">
              <button type="button" class="icon fa-solid fa-pen-to-square" data-action="edit" data-key="{{id}}" aria-label="Edit {{label}}"></button>
              <button type="button" class="icon fa-solid fa-xmark" data-action="remove" data-key="{{id}}" aria-label="Delete {{label}}"></button>
            </td>{{/if}}
          </tr>
        {{/each}}
      </tbody>
    </table>
    {{#unless rows.length}}<p class="hint">{{localize "swade-better-setting.UI.Nomovementpresets_6eb7abc7f4"}}</p>{{/unless}}
  </div>
  <footer class="sbs-preset-footer">
    {{#if canManage}}<button type="button" data-action="edit"><i class="fa-solid fa-plus" inert></i> {{localize "swade-better-setting.UI.Savecurrentmovementaspreset_d815d5290a"}}</button>{{/if}}
    <button type="button" data-action="close">{{localize "swade-better-setting.UI.Close_7d9eb7acb1"}}</button>
  </footer>
</section>
