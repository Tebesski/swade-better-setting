<aside class="sbs-npc-traits" aria-labelledby="{{partId}}-heading">
  <h2 id="{{partId}}-heading">{{localize "swade-better-setting.UI.Attributesandskills_ca8f493e99"}}</h2>
  <div class="sbs-npc-with-picker sbs-npc-primary">
    <label for="{{partId}}-focus">{{localize "swade-better-setting.UI.Primaryskill_09b0109988"}} <i class="fa-solid fa-circle-info sbs-npc-info" tabindex="0"
      aria-label="{{localize "swade-better-setting.UI.Thearchetypesmainskillgrows_3fadf9b529"}}"
      data-tooltip="{{localize "swade-better-setting.UI.Thearchetypesmainskillgrows_3fadf9b529"}}"></i></label>
    <input id="{{partId}}-focus" type="text" data-path="focus" value="{{draft.focus}}" list="{{traitListId}}" autocomplete="off">
    <button type="button" class="icon fa-solid fa-list" data-action="pickTrait" data-path="focus" aria-label="{{localize "swade-better-setting.UI.Chooseprimaryskill_4b62cb33c2"}}"></button>
  </div>
  <div class="sbs-npc-attributes" role="group" aria-label="{{localize "swade-better-setting.UI.Attributes_4b0ed88f7d"}}">
    {{#each attributes}}
      <div class="sbs-npc-attribute">
        <span>{{label}}{{#if effective}} <small class="sbs-npc-effective-die" aria-label="Effective die {{effective}}">{{effective}}</small>{{/if}}</span>
        {{#if fixed}}<span>{{localize "swade-better-setting.UI.1Tiny_0ad7a7d0d2"}}</span>{{else}}
        <select data-path="attributes.{{key}}.sides" data-number aria-label="{{label}} die">{{selectOptions @root.dice selected=sides}}</select>
        <input type="number" data-path="attributes.{{key}}.modifier" min="-20" max="20" value="{{this.modifier}}" aria-label="{{label}} modifier">
        {{/if}}
      </div>
    {{/each}}
  </div>
  <div class="sbs-npc-library-bar">
    <label class="sbs-npc-check"><input type="checkbox" data-path="core" aria-label="{{localize "swade-better-setting.UI.Includesettingcoreskills_a24c5bc85b"}}" {{checked draft.core}}> {{localize "swade-better-setting.UI.Coreskills_be127e338e"}}</label>
    <label class="sbs-npc-check"><input type="checkbox" data-path="animal" {{checked draft.animal}}> {{localize "swade-better-setting.UI.AnimalSmarts_3bda33e096"}}
      <i class="fa-solid fa-circle-info sbs-npc-info" tabindex="0" aria-label="{{localize "swade-better-setting.UI.MarksSmartsasanimalintelligenceThe_b56f727c8b"}}"
        data-tooltip="{{localize "swade-better-setting.UI.MarksSmartsasanimalintelligenceThe_b56f727c8b"}}"></i></label>
    <button type="button" data-action="addSkill"><i class="fa-solid fa-plus" inert></i> {{localize "swade-better-setting.UI.Addskill_bc4db5d337"}}</button>
  </div>
  <ul class="sbs-npc-skills unmarked-list">
    {{#each skills}}
      <li>
        <span>{{name}}</span>
        <select data-skill="{{key}}" data-field="attribute" aria-label="{{name}} linked attribute">{{selectOptions @root.labels selected=attribute blank="—"}}</select>
        <select data-skill="{{key}}" data-field="sides" aria-label="{{name}} die">{{selectOptions @root.dice selected=sides}}</select>
        <input type="number" data-skill="{{key}}" data-field="modifier" min="-20" max="20" value="{{this.modifier}}" aria-label="{{name}} modifier">
        <button type="button" class="icon fa-solid fa-xmark" data-action="removeSkill" data-key="{{key}}" aria-label="Remove {{name}}"></button>
      </li>
    {{/each}}
  </ul>
</aside>
