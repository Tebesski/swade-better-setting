<section class="sbs-picker-body">
  {{#if canCreate}}<button type="button" class="sbs-create" data-action="createSkill"><i class="fa-solid fa-plus" inert></i> Create new skill</button>{{/if}}
  <input type="search" value="{{query}}" placeholder="Search…" aria-label="Search skills and traits" autocomplete="off">
  <div class="sbs-results">
    {{#each sections}}
      <section class="sbs-group">
        <h3>{{label}}</h3>
        <ol class="unmarked-list">
          {{#each rows}}
            <li class="sbs-row" data-name="{{name}}">
              <a role="button" tabindex="0" class="sbs-star" data-action="star" data-key="{{key}}" aria-label="{{#if starred}}Unstar{{else}}Star{{/if}} {{name}}" aria-pressed="{{starred}}" title="{{#if starred}}Unstar{{else}}Star{{/if}}"><i class="{{#if starred}}fa-solid{{else}}fa-regular{{/if}} fa-star" inert></i></a>
              <button type="button" class="sbs-choice" data-action="choose" data-key="{{key}}">{{#if img}}<img src="{{img}}" alt="">{{/if}}<span>{{name}}</span>{{#if detail}}<small>{{detail}}</small>{{/if}}</button>
              {{#if includeLinkedSkills}}<label class="sbs-linked-skills"><input type="checkbox" data-linked-attribute="{{key}}" {{#if linkedSkills}}checked{{/if}}> All linked Skills</label>{{/if}}
              {{#if canManage}}<a role="button" tabindex="0" class="sbs-delete" data-action="deleteSkill" data-key="{{key}}" aria-label="Delete {{name}}" title="Delete skill"><i class="fa-solid fa-trash" inert></i></a>{{/if}}
            </li>
          {{/each}}
        </ol>
      </section>
    {{/each}}
    <p class="sbs-empty" {{#unless empty}}hidden{{/unless}}>No matching skills or traits.</p>
  </div>
</section>
