<section class="sbs-picker-body">
  {{#if canCreate}}<button type="button" class="sbs-create" data-action="createSkill"><i class="fa-solid fa-plus" inert></i> {{localize "swade-better-setting.UI.Createnewskill_7d7d4a1ad7"}}</button>{{/if}}
  <input type="search" value="{{query}}" placeholder="{{localize "swade-better-setting.UI.Search_7336265a04"}}" aria-label="{{searchLabel}}" autocomplete="off">
  {{#if categories}}<label>{{localize "swade-better-setting.UI.Category_292c06f004"}} <select data-choice-category aria-label="{{localize "swade-better-setting.UI.Edgecategory_701ac6821b"}}">{{selectOptions categories selected=category blank="All categories"}}</select></label>{{/if}}
  {{#if loading}}<p role="status">{{#if loadingMessage}}{{loadingMessage}}{{else}}{{localize "swade-better-setting.UI.Loadingchoices_747544a156"}}{{/if}}</p>{{/if}}
  {{#if notice}}<p class="hint" role="status">{{notice}}</p>{{/if}}
  <div class="sbs-results">
    {{#each sections}}
      <section class="sbs-group">
        {{#if label}}<h3>{{label}}</h3>{{/if}}
        <ol class="unmarked-list">
          {{#each rows}}
            <li class="sbs-row" data-name="{{name}}">
              {{#if canStar}}<a role="button" tabindex="0" class="sbs-star" data-action="star" data-key="{{key}}" aria-label="{{#if starred}}Unstar{{else}}Star{{/if}} {{name}}" aria-pressed="{{starred}}" title="{{#if starred}}Unstar{{else}}Star{{/if}}"><i class="{{#if starred}}fa-solid{{else}}fa-regular{{/if}} fa-star" inert></i></a>{{/if}}
              <button type="button" class="sbs-choice" data-action="choose" data-key="{{key}}">{{#if img}}<img src="{{img}}" alt="">{{/if}}<span>{{name}}</span>{{#if detail}}<small>{{detail}}</small>{{/if}}</button>
              {{#if @root.canPreview}}<button type="button" class="icon fa-solid fa-eye sbs-preview-choice" data-action="preview" data-key="{{key}}" aria-label="Open {{name}}" data-tooltip="Open {{name}}"></button>{{/if}}
              {{#if includeLinkedSkills}}<label class="sbs-linked-skills"><input type="checkbox" data-linked-attribute="{{key}}" {{#if linkedSkills}}checked{{/if}}> {{localize "swade-better-setting.UI.AlllinkedSkills_ae20ac6578"}}</label>{{/if}}
              {{#if canManage}}<a role="button" tabindex="0" class="sbs-delete" data-action="deleteSkill" data-key="{{key}}" aria-label="Delete {{name}}" title="{{localize "swade-better-setting.UI.Deleteskill_d60d2a2ab6"}}"><i class="fa-solid fa-trash" inert></i></a>{{/if}}
            </li>
          {{/each}}
        </ol>
      </section>
    {{/each}}
    <p class="sbs-empty" hidden>{{emptyMessage}}</p>
  </div>
  {{#if choicePages}}
    <nav class="sbs-bestiary-pages" aria-label="{{localize "swade-better-setting.UI.Choicepages_f2cf5e4540"}}">
      <button type="button" data-action="previousChoices" {{disabled (not previousChoices)}}>{{localize "swade-better-setting.UI.Previous_a57b08a480"}}</button>
      <span>{{localize "swade-better-setting.UI.Page_0a30a815d6"}} {{choicePage}} {{localize "swade-better-setting.UI.of_28391d3bc6"}} {{choiceTotalPages}}</span>
      <button type="button" data-action="nextChoices" {{disabled (not nextChoices)}}>{{localize "swade-better-setting.UI.Next_1ff57a29d7"}}</button>
    </nav>
  {{/if}}
</section>
